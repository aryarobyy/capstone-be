# Server configuration
PORT=8080
ENV=development # development, staging, production

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=tani_pintar_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# JWT configuration
# Generate a random secret, e.g. openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_MINUTES=15
# Sessions and rotating refresh tokens have an absolute 30-day lifetime.

# Firebase Cloud Messaging (service account credentials stay outside the repository)
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
